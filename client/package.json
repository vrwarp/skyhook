{
  "name": "skyhook-client",
  "version": "0.1.0",
  "private": true,
  "description": "Skyhook plane-side client: a PWA that patches a mirrored DOM and serialises input",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --dev",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "node esbuild.mjs --dev && python3 -m http.server 8080 --directory dist"
  },
  "dependencies": {
    "cbor-x": "^1.6.6",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
