{
  "id": "forms/frame-editing",
  "title": "an edit inside a mirrored cross-origin frame reaches that frame's page",
  "covers": ["contenteditable", "cross-origin frames", "setvalue routing"],
  "gaps": ["P-102"],
  "waitText": "widget settled",
  "serve": {"cdn": ["widget.html"]},
  "interactions": [
    {"do": "type", "target": "#pad-top", "value": "hi"},
    {"do": "waitText", "value": "edited-top: hi", "name": "a top-level edit reaches the page"},
    {"do": "type", "target": "#pad-frame", "value": "yo"},
    {"do": "waitText", "value": "edited-frame: yo", "within": 12, "name": "an edit inside a frame reaches its page"}
  ]
}
